# ═══════════════════════════════════════════════════════════════════════════
# PHB / SPIRIT GUIDE — environment template
#
# Copy this file to .env and fill in the values. NEVER commit .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# ═══════════════════════════════════════════════════════════════════════════

# ─── RPC endpoints (public — no secret) ─────────────────────────────────
BASE_RPC=https://base-rpc.publicnode.com

# ─── Deployer private key ───────────────────────────────────────────────
# Use a DEDICATED deployer wallet — never your main wallet.
# Fund it with ~$2 of ETH on Base for gas.
# Format: 0x + 64 hex characters.
DEPLOYER_PK=

# ─── Miner private key (for autobot.js) ────────────────────────────────
# Separate wallet from deployer. Fund with ~$1 ETH for submission gas.
MINER_PK=

# ─── Token addresses on Base (public — no secret) ───────────────────────
PIDX_TOKEN=0x95c7e2d53f4b615a50d4468dfd5aff850dc17f0c
SGUIDE_TOKEN=0xb50DCEb0570557B9B7FE43D8cBDc9B3457D3dc5a
VDOO_TOKEN=0x38e4f08D08b4D772A7B75669C356b4749dd2d30b
PENNIES_TOKEN=0x2a92CAA3b01E64634e2E95AA533a5570a76c19A7

# ─── Deployment parameters (public) ─────────────────────────────────────
# Mining
REWARD_PER_SHARE=100000000000000000000
DIFFICULTY=1766847064778384329583297500742918515827483896875618958121606201292619776

# Staking
STAKE_TOKEN=0x95c7e2d53f4b615a50d4468dfd5aff850dc17f0c
