name: Finalize Pennies Index
on: workflow_dispatch
jobs:
  finalize:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install Foundry
        uses: foundry-rs/foundry-toolchain@v1
        with: { version: nightly }
      - name: Setup Python
        uses: actions/setup-python@v5
        with: { python-version: '3.10' }
      - run: pip install web3 requests
      - name: Create contract source
        run: |
          mkdir -p src
          cat > src/Token.sol << 'SOL'
          // SPDX-License-Identifier: MIT
          pragma solidity ^0.8.13;
          contract PenniesIndex {
              string public name = "Pennies Index";
              string public symbol = "PIDX";
              uint8 public decimals = 18;
              uint256 public totalSupply = 1000000000 * 10**18;
              mapping(address => uint256) public balanceOf;
              mapping(address => mapping(address => uint256)) public allowance;
              event Transfer(address indexed from, address indexed to, uint256 value);
              event Approval(address indexed owner, address indexed spender, uint256 value);
              constructor() { balanceOf[msg.sender] = totalSupply; emit Transfer(address(0), msg.sender, totalSupply); }
              function transfer(address to, uint256 value) external returns (bool) {
                  require(balanceOf[msg.sender] >= value, "insufficient balance");
                  balanceOf[msg.sender] -= value; balanceOf[to] += value;
                  emit Transfer(msg.sender, to, value); return true;
              }
              function approve(address spender, uint256 value) external returns (bool) {
                  allowance[msg.sender][spender] = value;
                  emit Approval(msg.sender, spender, value); return true;
              }
              function transferFrom(address from, address to, uint256 value) external returns (bool) {
                  require(balanceOf[from] >= value, "insufficient balance");
                  require(allowance[from][msg.sender] >= value, "insufficient allowance");
                  balanceOf[from] -= value; balanceOf[to] += value;
                  allowance[from][msg.sender] -= value;
                  emit Transfer(from, to, value); return true;
              }
          }
          SOL
      - name: Verify contract
        run: |
          forge flatten src/Token.sol > Token_flattened.sol
          forge verify-contract \
            --chain-id 8453 \
            --rpc-url https://mainnet.base.org \
            --verifier-url https://api.basescan.org/api \
            --etherscan-api-key ${{ secrets.ETHERSCAN_API_KEY }} \
            "0xd7dEf6924835d83ca11fcd7a16271CA919723e65" \
            src/Token.sol:PenniesIndex \
            --num-of-optimizations 0 \
            --watch || echo "Verification may have already been done."
      - name: Airdrop
        env:
          PRIVATE_KEY: ${{ secrets.PRIVATE_KEY }}
          RPC_URL: ${{ secrets.BASE_RPC_URL }}
        run: |
          python3 << 'EOF'
          import json, time, sys
          from web3 import Web3
          RPC = "${{ secrets.BASE_RPC_URL }}"
          PK = "${{ secrets.PRIVATE_KEY }}"
          TOKEN_ADDR = "0xd7dEf6924835d83ca11fcd7a16271CA919723e65"
          DEPLOYER = "0x3212D08f2ad637918bd90932829159874E39bE4c"
          CHAIN_ID = 8453
          with open("airdrop_list.json") as f:
              recipients = json.load(f)
          if not recipients:
              print("No recipients"); sys.exit(1)
          recipients = [Web3.to_checksum_address(addr) for addr in recipients]
          w3 = Web3(Web3.HTTPProvider(RPC))
          account = w3.eth.account.from_key(PK)
          erc20_abi = [{"constant":False,"inputs":[{"name":"to","type":"address"},{"name":"value","type":"uint256"}],"name":"transfer","outputs":[{"name":"","type":"bool"}],"type":"function"}]
          contract = w3.eth.contract(address=TOKEN_ADDR, abi=erc20_abi)
          AMOUNT = 1000 * 10**18
          nonce = w3.eth.get_transaction_count(DEPLOYER, "pending")
          for addr in recipients:
              if not addr.startswith("0x") or len(addr)!=42: continue
              tx = contract.functions.transfer(addr, AMOUNT).build_transaction({
                  "from": DEPLOYER, "gas": 100000,
                  "gasPrice": w3.eth.gas_price,
                  "nonce": nonce, "chainId": CHAIN_ID
              })
              signed = account.sign_transaction(tx)
              raw = getattr(signed, "raw_transaction") or getattr(signed, "rawTransaction")
              tx_hash = w3.eth.send_raw_transaction(raw)
              print(f"Sent to {addr[:10]}... TX: {tx_hash.hex()[:10]}")
              nonce += 1
              time.sleep(1)
          print("✅ Airdrop complete!")
          EOF
      - name: Install forge-std
        run: forge install foundry-rs/forge-std
      - name: Add liquidity
        if: success()
        env:
          PRIVATE_KEY: 0x${{ secrets.PRIVATE_KEY }}
        run: |
          forge script script/AddLiquidity.s.sol:AddLiquidityScript \
            --rpc-url ${{ secrets.BASE_RPC_URL }} \
            --private-key ${{ secrets.PRIVATE_KEY }} \
            --broadcast \
            --chain-id 8453 \
            --gas-price 1000000000
      - name: Show links
        run: |
          echo "🔗 Uniswap: https://app.uniswap.org/swap?chain=base&outputCurrency=0xd7dEf6924835d83ca11fcd7a16271CA919723e65"
          echo "📊 DexScreener: https://dexscreener.com/base/0xd7dEf6924835d83ca11fcd7a16271CA919723e65"
